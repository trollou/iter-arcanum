{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.rs)",
            "shell": "bash",
            "command": "cargo fmt --all"
          },
          {
            "type": "command",
            "if": "Write(*.rs)",
            "shell": "bash",
            "command": "cargo fmt --all"
          },
          {
            "type": "command",
            "if": "MultiEdit(*.rs)",
            "shell": "bash",
            "command": "cargo fmt --all"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "shell": "bash",
            "timeout": 900,
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/verifier.sh\" 1>&2 || { echo 'Push bloqué : fmt, clippy ou test en échec. Corriger avant de pousser.' >&2; exit 2; }"
          }
        ]
      }
    ]
  }
}
